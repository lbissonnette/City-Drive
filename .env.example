# Google Maps Platform key with these APIs enabled:
#   Maps JavaScript API, Street View Static API, Routes API
GOOGLE_MAPS_API_KEY=

# Optional: a second key used only by the server (Routes + Static image downloads).
# Lets you HTTP-referrer-restrict the browser key above. Defaults to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_KEY=

# Optional: Cloud Storage bucket shared with the GPU video worker (worker/README.md).
# Enables the "Make a video" step. Locally, uses your `gcloud auth login` credentials.
VIDEO_BUCKET=

# Optional: where the GPU worker VM lives, for the app's Start/Stop buttons and
# auto-start. On Cloud Run the project comes from the metadata server and the
# zone is looked up, so these only matter locally (or to skip the lookup).
GCP_PROJECT_ID=
GPU_VM_ZONE=

# Optional: your GPU VM's spot price per hour and disk cost per month, for the
# app's cost estimate. Defaults: 1.7 and 25 (USD).
GPU_VM_HOURLY_USD=
GPU_VM_DISK_MONTHLY_USD=

# Optional: where the app's /comfy/ proxy sends ComfyUI requests. On Cloud Run it
# finds the GPU VM's internal IP itself; locally, point it at `scripts/gpu-vm.sh tunnel`.
COMFY_URL=

PORT=3000
