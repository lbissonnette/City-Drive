# Google Maps Platform key with these APIs enabled:
#   Maps JavaScript API, Street View Static API, Routes API
GOOGLE_MAPS_API_KEY=

# Optional: a second key used only by the server (Routes + Static image downloads).
# Lets you HTTP-referrer-restrict the browser key above. Defaults to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_KEY=

# Optional: Cloud Storage bucket shared with the GPU video worker (worker/README.md).
# Enables the "Make a video" step. Locally, uses your `gcloud auth login` credentials.
VIDEO_BUCKET=

PORT=3000
